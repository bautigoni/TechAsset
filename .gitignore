# Variables de entorno reales (.env.example sí se versiona)
.env
.env.local
*.local

# Logs / cachés
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm-cache/
.claude/

# Bases SQLite locales
data/techasset.db
data/*.db
data/*.db-wal
data/*.db-shm
data/tmp/

# Backups (NUNCA versionar: contienen datos reales de la base y .env)
backups/
*.db
*.db-wal
*.db-shm
*.env.backup*
.env.backup*

# Archivos pesados / locales
TechAsset/
TechAssetfv/
TechAssetvf/
*.mp4
data/procedimientos/*.mp4
