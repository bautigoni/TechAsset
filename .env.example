PORT=8000
APP_NAME=TechAsset
# URL base pública usada en links de los mails (registros, aprobaciones, etc.)
# En producción: https://techasset.tu-dominio
APP_BASE_URL=http://127.0.0.1:8000
DEFAULT_SITE_CODE=NFPT
BOOTSTRAP_SITES=NFPT:Northfield Puertos,NFND:Northfield Nordelta
AUTH_ALLOWED_EMAILS=admin@northfield.local

# Base local SQLite. Es la fuente principal de verdad.
SQLITE_DB_PATH=./data/techasset.db

# Importación manual opcional desde CSV publicado. No se usa para sincronización viva.
GOOGLE_SHEET_CSV_URL=
CACHE_CSV_PATH=./data/cache_sheet.csv
DEVICES_APP_CSV_PATH=./data/devices_app.csv

AUTO_REFRESH_SECONDS=5

# Herramientas auxiliares
TOOLS_TEMP_DIR=./data/tmp
MAX_UPLOAD_MB=10

# Notificaciones administrativas (registros, aprobaciones, etc.)
SUPERADMIN_EMAILS=admin@example.com,techassetbot@gmail.com

# SMTP / Bot de mail (Gmail con contraseña de aplicación)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=techassetbot@gmail.com
SMTP_APP_PASSWORD=
MAIL_FROM=TechAsset Bot <techassetbot@gmail.com>
MAIL_SUBJECT=Credenciales de acceso
# MODO_PRUEBA=true loguea pero NO envía. Pasar a false en producción.
MODO_PRUEBA=true
MICROSOFT_LOGIN_URL=

# Resend (preferido para envios reales si esta configurado)
RESEND_API_KEY=
RESEND_FROM=TechAsset <noreply@techasset.bauhub.online>

# URL pública de la app (links de tickets InVgate, mails de notificaciones, etc.)
TECHASSET_PUBLIC_URL=https://techasset.bauhub.online

# Notificaciones push (opcional). Si faltan, las push caen a in-app + mail sin romper.
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:techassetbot@gmail.com

# Login con Google (OAuth 2.0). Si CLIENT_ID/SECRET están vacíos, el botón "Continuar
# con Google" se oculta automáticamente en la pantalla de login.
# Setup: https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth Client ID
# Authorized redirect URIs tiene que incluir EXACTAMENTE el valor de GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://techasset.bauhub.online/api/auth/callback/google
# CSV de dominios permitidos (sin @). Vacío = cualquier Google account puede intentar
# (el filtro real sigue siendo la tabla allowed_users).
GOOGLE_ALLOWED_DOMAINS=
